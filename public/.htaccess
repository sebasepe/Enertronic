# ═══════════════════════════════════════════════════════════════════════════════
# ENERTRONIC — CONFIGURACIÓN APACHE / CPANEL PARA ANGULAR SSR & SEO
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Asegurar que Apache sirva index.html antes que index.php (vital en migración desde WordPress)
DirectoryIndex index.html index.php

# Deshabilitar listado de directorios
Options -Indexes

# ── 2. Headers de Seguridad (mod_headers) ──
<IfModule mod_headers.c>
    # Previene Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Previene MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Activa filtro XSS
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy para SEO y privacidad
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Ocultar cabeceras del servidor
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── 3. Compresión GZIP / Deflate  ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 4. Caché de Navegador  ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ── 5. Reglas de Reescritura, HTTPS y Enrutamiento Angular ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Forzar HTTPS (301 permanente para SEO)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Forzar dominio canónico sin "www" (enertronic.com.pe)
    RewriteCond %{HTTP_HOST} ^www\.enertronic\.com\.pe$ [NC]
    RewriteRule ^ https://enertronic.com.pe%{REQUEST_URI} [L,R=301]

    # C. Redirecciones 301 desde WordPress (vital para no perder autoridad ni tráfico SEO)
    RewriteRule ^contacto/?$ /contactos [R=301,L]
    RewriteRule ^la-empresa/?$ /nosotros [R=301,L]
    RewriteRule ^servicios/?$ /soluciones-enertronic [R=301,L]
    RewriteRule ^proyectos/?$ /casos-de-exito [R=301,L]
    RewriteRule ^soluciones/?$ /soluciones-enertronic [R=301,L]
    RewriteRule ^soluciones-enertronic/(.+)$ /soluciones/$1 [R=301,L]

    # Redirecciones 301 de URLs legacy de soluciones
    RewriteRule ^soluciones/telemetria-celular-2g-3g-4g/?$ /soluciones/solucion-de-telemetria-celular-2g-3g-4g [R=301,L]
    RewriteRule ^soluciones/telemetria-satelital-iridium/?$ /soluciones/solucion-de-telemetria-satelital-iridium [R=301,L]
    RewriteRule ^soluciones/telemetria-satelital-starlink/?$ /soluciones/solucion-de-telemetria-satelital-starlink [R=301,L]
    RewriteRule ^soluciones/telemetria-radio-mesh-2-4ghz/?$ /soluciones/solucion-de-telemetria-radio-mesh-2-4ghz [R=301,L]
    RewriteRule ^soluciones/telemetria-mqtt/?$ /soluciones/solucion-de-telemetria-mqtt [R=301,L]
    RewriteRule ^soluciones/telemetria-ethernet/?$ /soluciones/solucion-de-telemetria-ethernet [R=301,L]
    RewriteRule ^soluciones/telemetria-wifi/?$ /soluciones/solucion-de-telemetria-wifi [R=301,L]
    RewriteRule ^soluciones/satelital-inmarsat-bgan-m2m/?$ /soluciones/solucion-de-telemetria-satelital-inmarsat-bgan-m2m [R=301,L]
    RewriteRule ^soluciones/telemetria-lorawan/?$ /soluciones/solucion-de-telemetria-lorawan [R=301,L]
    RewriteRule ^soluciones/tunel-inalambrico-2-4ghz/?$ /soluciones/solucion-de-telemetria-tunel-inalambrico-2-4ghz [R=301,L]
    RewriteRule ^soluciones/vision-remota-scada-industrial/?$ /soluciones/soluciones-integrales-de-telemetria-scada-y-vision-remota-industrial [R=301,L]
    RewriteRule ^soluciones/telemetria-monitoreo-automotor-mineria/?$ /soluciones/soluciones-telemetria-monitoreo-automotor-mineria [R=301,L]

    # D. Redirección 301 para URLs con barra final a sin barra (excepto si es directorio real)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # E. Permitir archivos y carpetas que existen físicamente 
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # F. Permitir el proxy PHP del formulario de contacto
    RewriteCond %{REQUEST_URI} ^/send-contact\.php$
    RewriteRule ^ - [L]

    # G. SPA Fallback: Todo lo no encontrado se entrega al index.html de Angular
    RewriteRule ^ index.html [L]
</IfModule>

# ── 6. Protección del Proxy PHP del formulario ──
<Files "send-contact.php">
    <LimitExcept POST>
        Require all denied
    </LimitExcept>
</Files>

# ── 7. Proteger archivos sensibles ──
<FilesMatch "\.(env|log|lock|ts|scss|git|md|yml|yaml|bak|config)$">
    Require all denied
</FilesMatch>
